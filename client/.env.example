# Copy to .env (gitignored) and set to your Render server URL.
# In dev, leave this blank — the Vite proxy routes /api to localhost:4000.
# Production: the value here is also baked into the bundle at build time
# by the Render static-site service (see render.yaml's VITE_API_URL).
VITE_API_URL=https://arbihunt-3.onrender.com