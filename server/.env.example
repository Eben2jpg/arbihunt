# Copy this file to .env and fill in your values.
# This file is committed so newcomers can see what to configure.
# Real .env is gitignored.

# Server
PORT=4000
NODE_ENV=production
# Where the React frontend is hosted. Comma-separate for multiple origins.
# In production set this to the Vercel URL of the client.
CLIENT_ORIGIN=https://arbihunt.vercel.app
# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Persistent DB location. On Render set to /data/db.json so the file
# survives restarts on the persistent disk.
DB_PATH=/data/db.json

# Scanner tuning
SCAN_INTERVAL_MS=25000
MAX_OPPORTUNITIES=1000

# Owner email — the in-app owner panel shows up for this account.
OWNER_EMAIL=you@example.com

# USDT receiving addresses (public, fine to put here).
USDT_TRON_ADDRESS=TYourTronAddressHere
USDT_BSC_ADDRESS=0xYourBscAddressHere

# Block explorer keys (free tier is enough).
TRONGRID_API_KEY=
BSCSCAN_API_KEY=

# Confirmation thresholds for the payment monitor.
REQUIRED_CONFIRMATIONS_TRON=19
REQUIRED_CONFIRMATIONS_BSC=15

# Email (Resend). Leave blank and set RESET_CODE_EXPOSED=false in
# production so reset codes are only sent out-of-band.
RESEND_API_KEY=
EMAIL_FROM=ArbiHunt <noreply@example.com>
RESET_CODE_EXPOSED=false

# Demo seed is permanently off. Live CCXT scan only.
ENABLE_DEMO_SEED=false

# Exchange API keys (optional, all 36 declared exchanges).
# Public endpoints work without them; keys raise the rate-limit ceiling
# if a venue throttles your IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
